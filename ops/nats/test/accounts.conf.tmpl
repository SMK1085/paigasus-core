# SPDX-License-Identifier: Apache-2.0
#
# Static-nkey mirror of the production account (SMA-493 D2), included by both fixture server
# configs so the plaintext and TLS runs cannot drift apart.
#
# The `{{…_NKEY}}` placeholders are rendered at test time with freshly minted public keys:
# committing fixed identities would mean committing their seeds, which are private keys. The
# permission lists — the part that actually matters — are committed verbatim and asserted against
# `subjects.env` by `check-subjects.sh`.
#
# Production uses operator-mode JWTs instead (see `provision.sh`); the subject lists are identical
# in both encodings.

accounts {
  SYS: {
    users: [ { nkey: "{{SYS_NKEY}}" } ]
  }

  PAIGASUS_IAM: {
    # max_mem 0 disables memory storage outright: the stream is File-backed (SMA-471 D8) and a
    # memory stream would silently lose everything on a broker restart.
    jetstream: { max_mem: 0, max_file: 536870912, max_streams: 4, max_consumers: 32 }

    users: [
      {
        nkey: "{{PUBLISHER_NKEY}}"
        permissions: {
          publish:   { allow: [ "iam.>", "$JS.API.STREAM.INFO.IAM_EVENTS", "$JS.API.STREAM.CREATE.IAM_EVENTS" ] }
          subscribe: { allow: [ "_INBOX_IAM_PUB.>" ] }
        }
      },
      {
        nkey: "{{CONSUMER_NKEY}}"
        permissions: {
          publish:   { allow: [ "$JS.API.CONSUMER.MSG.NEXT.IAM_EVENTS.gateway-cache-invalidator", "$JS.API.CONSUMER.INFO.IAM_EVENTS.gateway-cache-invalidator", "$JS.ACK.IAM_EVENTS.gateway-cache-invalidator.>" ] }
          subscribe: { allow: [ "_INBOX_GW.>", "iam.policy.>" ] }
        }
      },
      {
        nkey: "{{PROVISIONER_NKEY}}"
        permissions: {
          publish:   { allow: [ "$JS.API.INFO", "$JS.API.STREAM.>", "$JS.API.CONSUMER.>" ] }
          subscribe: { allow: [ "_INBOX_PROV.>" ] }
        }
      }
    ]
  }

  # The gateway tool decision log (SMA-755). A separate account, so a full decision stream cannot stop
  # IAM_EVENTS. max_mem 0: the stream is file-backed. The reader's ordered consumer asks for memory
  # storage of its state (async-nats 0.53 sets memory_storage), and the broker accepts it under max_mem 0.
  PAIGASUS_GATEWAY: {
    jetstream: { max_mem: 0, max_file: 268435456, max_streams: 2, max_consumers: 16 }

    users: [
      {
        nkey: "{{GW_DEC_PUBLISHER_NKEY}}"
        permissions: {
          publish:   { allow: [ "gateway.decision.>", "$JS.API.INFO", "$JS.API.STREAM.INFO.GATEWAY_DECISIONS", "$JS.API.STREAM.CREATE.GATEWAY_DECISIONS", "$JS.API.STREAM.INFO.KV_GATEWAY_DECISIONS_GEN", "$JS.API.DIRECT.GET.KV_GATEWAY_DECISIONS_GEN.>", "$KV.GATEWAY_DECISIONS_GEN.>" ] }
          subscribe: { allow: [ "_INBOX_GW_DEC.>" ] }
        }
      },
      {
        nkey: "{{GW_DEC_READER_NKEY}}"
        permissions: {
          publish:   { allow: [ "$JS.API.CONSUMER.CREATE.GATEWAY_DECISIONS", "$JS.API.CONSUMER.CREATE.GATEWAY_DECISIONS.>", "$JS.API.CONSUMER.DELETE.GATEWAY_DECISIONS.*", "$JS.API.CONSUMER.MSG.NEXT.GATEWAY_DECISIONS.*", "$JS.API.CONSUMER.INFO.GATEWAY_DECISIONS.*" ] }
          subscribe: { allow: [ "_INBOX_GW_RD.>" ] }
        }
      },
      {
        nkey: "{{GW_DEC_PROVISIONER_NKEY}}"
        permissions: {
          publish:   { allow: [ "$JS.API.INFO", "$JS.API.STREAM.>" ] }
          subscribe: { allow: [ "_INBOX_GW_PROV.>" ] }
        }
      }
    ]
  }
}

system_account: SYS
