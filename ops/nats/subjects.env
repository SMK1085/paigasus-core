# SPDX-License-Identifier: Apache-2.0
#
# The single source for every NATS subject and inbox prefix this platform grants (SMA-493 D10).
# `provision.sh` sources this to mint production users; `check-subjects.sh` asserts the test
# fixture grants exactly these. Editing a list here and nowhere else is the intended workflow —
# the gate fails until the fixture agrees.

STREAM_NAME="IAM_EVENTS"
DURABLE_NAME="gateway-cache-invalidator"

# Per-user inbox prefixes (D4). These are NOT cosmetic: JetStream acks and pull deliveries both
# land on the client's inbox, so a shared `_INBOX.>` grant inside one account lets any client
# read another's deliveries.
PUBLISHER_INBOX_PREFIX="_INBOX_IAM_PUB"
CONSUMER_INBOX_PREFIX="_INBOX_GW"
PROVISIONER_INBOX_PREFIX="_INBOX_PROV"
AGENT_HOST_INBOX_PREFIX="_INBOX_AGH"
AGENT_HOST_DURABLE_NAME="agent-host-inbox"

# iam-publisher — the paigasus-iam outbox relay's delivery identity (D3).
# `get_or_create_stream` probes STREAM.INFO and CREATEs on a 404, so both are required; the
# subscribe grant is what receives the JetStream publish ack, without which every publish times
# out. No `sub iam.>`: the publisher must not read the graph it writes. No STREAM.UPDATE /
# DELETE / PURGE: SMA-471 D7 makes non-reconciliation deliberate, and this enforces it.
PUBLISHER_PUB=(
  "iam.>"
  '$JS.API.STREAM.INFO.'"$STREAM_NAME"
  '$JS.API.STREAM.CREATE.'"$STREAM_NAME"
)
PUBLISHER_SUB=(
  "$PUBLISHER_INBOX_PREFIX.>"
)

# gateway-consumer — SMA-492's cache-invalidation identity (D5), and since SMA-752 the gateway's
# tool-policy invalidation subscriber (D4, Q1-A). Two read paths, narrowed in two different ways:
# - Pull deliveries from the durable arrive on the inbox, never on `iam.*`, so a subject-level
#   subscribe permission cannot narrow THAT path. Its narrowing lives in the PRE-PROVISIONED
#   durable's filter_subjects, and is binding only because no CONSUMER.CREATE (or UPDATE) verb is
#   granted in any form.
# - `iam.policy.>` (SMA-752) is a CORE subscription, and it IS subject-level: each gateway
#   replica gets every policy event, because a JetStream publish is also delivered to the core
#   subscribers of its subject. It is the only subscribe grant outside the inbox. It adds no
#   publish right and no JetStream API right, so it cannot forge an event or touch the durable.
CONSUMER_PUB=(
  '$JS.API.CONSUMER.MSG.NEXT.'"$STREAM_NAME"'.'"$DURABLE_NAME"
  '$JS.API.CONSUMER.INFO.'"$STREAM_NAME"'.'"$DURABLE_NAME"
  '$JS.ACK.'"$STREAM_NAME"'.'"$DURABLE_NAME"'.>'
)
CONSUMER_SUB=(
  "$CONSUMER_INBOX_PREFIX.>"
  "iam.policy.>"
)

# agent-host-consumer — the agent host's event inbox identity (SMA-787 §9.2, §9.5). It follows
# `gateway-consumer`: a pull consumer on a PRE-PROVISIONED durable, with its own inbox prefix.
# - Pull deliveries arrive on the inbox, never on `iam.*`, so a subject permission cannot narrow
#   them. The narrowing lives in the durable's filter_subjects (AGENT_HOST_FILTER_SUBJECTS), and it
#   is binding only because no CONSUMER.CREATE (or UPDATE) verb is granted in any form.
# - CONSUMER.INFO is for the boot check (Task 18). STREAM.INFO is NOT granted: the host never
#   creates or reads a stream, and it never creates a consumer.
# - It grants only the durable `agent-host-inbox`, not `gateway-cache-invalidator`, so the host
#   cannot pull the gateway's deliveries. Its inbox prefix differs from `_INBOX_GW`, so neither
#   consumer can read the other's replies.
# - No `iam.>` subscribe, no publish on `iam.>`: the host can neither read nor forge events.
AGENT_HOST_CONSUMER_PUB=(
  '$JS.API.CONSUMER.MSG.NEXT.'"$STREAM_NAME"'.'"$AGENT_HOST_DURABLE_NAME"
  '$JS.API.CONSUMER.INFO.'"$STREAM_NAME"'.'"$AGENT_HOST_DURABLE_NAME"
  '$JS.ACK.'"$STREAM_NAME"'.'"$AGENT_HOST_DURABLE_NAME"'.>'
)
AGENT_HOST_CONSUMER_SUB=(
  "$AGENT_HOST_INBOX_PREFIX.>"
)

# iam-provisioner — operator tooling only, NEVER deployed with a service.
# Deliberately not `$JS.API.>`: `STREAM.>` already includes STREAM.MSG.GET (a full reader of the
# authorization change graph, accepted — see permissions.md §9), so narrowing to STREAM.> +
# CONSUMER.> buys reviewability, not confidentiality — it keeps this identity's grant list a
# short, auditable blast radius rather than an unbounded top-level wildcard. `$JS.API.INFO` is
# account-tier info, which the `nats` CLI requests on startup.
PROVISIONER_PUB=(
  '$JS.API.INFO'
  '$JS.API.STREAM.>'
  '$JS.API.CONSUMER.>'
)
PROVISIONER_SUB=(
  "$PROVISIONER_INBOX_PREFIX.>"
)

# The durable's filter (D5). Revocations and grants change authz outcomes; `principal.created`
# and `api_key.issued` are excluded because nothing is cached about a principal or key that does
# not exist yet. SMA-492 may widen this — and can, without touching either service, because the
# filter lives in the provisioned durable rather than in a permission.
CONSUMER_FILTER_SUBJECTS=(
  "iam.role.granted"
  "iam.role.revoked"
  "iam.api_key.revoked"
  "iam.principal.archived"
  "iam.policy.put"
  "iam.policy.deleted"
)

# The agent host durable's filter (SMA-787 §9.2). One entry per channel subject. `provision.sh`
# passes one `--filter` per entry. The filter lives in the provisioned durable, not in a permission.
AGENT_HOST_FILTER_SUBJECTS=(
  "iam.organization.>"
)

# The gateway tool decision log (SMA-755 § 5.10, P-15, P-20). The stream lives in its own account, so a
# full decision stream cannot stop IAM_EVENTS. The relay in `paigasus-gateway` and `provision-decisions.sh`
# both build the stream from these values, and a gateway unit test pins the Rust constants to them. The
# test parses the `:-N` default of DECISIONS_ACCOUNT_DISK_BYTES and computes `N * 9 / 10` itself, so keep
# that form. The three identities below use this stream.
GATEWAY_ACCOUNT="PAIGASUS_GATEWAY"
DECISIONS_STREAM_NAME="GATEWAY_DECISIONS"
DECISIONS_SUBJECTS="gateway.decision.>"
DECISIONS_MAX_AGE_SECS=2592000
DECISIONS_ACCOUNT_DISK_BYTES="${DECISIONS_ACCOUNT_DISK_BYTES:-21474836480}"
DECISIONS_MAX_BYTES=$(( DECISIONS_ACCOUNT_DISK_BYTES * 9 / 10 ))
DECISIONS_DUPE_WINDOW_SECS=120
DECISIONS_MAX_MSG_SIZE=65536

# Per-identity inbox prefixes in the gateway account, for the same reason as the IAM prefixes above.
GW_DEC_PUBLISHER_INBOX_PREFIX="_INBOX_GW_DEC"
GW_DEC_READER_INBOX_PREFIX="_INBOX_GW_RD"
GW_DEC_PROVISIONER_INBOX_PREFIX="_INBOX_GW_PROV"

# gateway-decision-publisher — the gateway relay (P-14, P-15). `get_or_create_stream` probes STREAM.INFO and
# creates the stream on a 404. Before that, the relay reads the account storage limit with `$JS.API.INFO` (a
# read-only call) and sizes `max_bytes` to 90 % of it, so a smaller DECISIONS_ACCOUNT_DISK_BYTES does not make
# the broker refuse the create. The subscribe grant receives the PubAck. It has no read, delete or purge right.
GW_DEC_PUBLISHER_PUB=(
  "gateway.decision.>"
  '$JS.API.INFO'
  '$JS.API.STREAM.INFO.'"$DECISIONS_STREAM_NAME"
  '$JS.API.STREAM.CREATE.'"$DECISIONS_STREAM_NAME"
)
GW_DEC_PUBLISHER_SUB=(
  "$GW_DEC_PUBLISHER_INBOX_PREFIX.>"
)

# gateway-decision-reader — the export CLI (P-13). It reads with an ordered consumer: the first create has no
# name, a recreate has a name and a filter suffix, and it deletes the old consumer first. No $JS.ACK: an
# ordered consumer has ack_policy none. This identity is never deployed with the gateway.
GW_DEC_READER_PUB=(
  '$JS.API.CONSUMER.CREATE.'"$DECISIONS_STREAM_NAME"
  '$JS.API.CONSUMER.CREATE.'"$DECISIONS_STREAM_NAME"'.>'
  '$JS.API.CONSUMER.DELETE.'"$DECISIONS_STREAM_NAME"'.*'
  '$JS.API.CONSUMER.MSG.NEXT.'"$DECISIONS_STREAM_NAME"'.*'
  '$JS.API.CONSUMER.INFO.'"$DECISIONS_STREAM_NAME"'.*'
)
GW_DEC_READER_SUB=(
  "$GW_DEC_READER_INBOX_PREFIX.>"
)

# gateway-decision-provisioner — operator tooling only, NEVER deployed (P-15). The `nats` CLI calls
# $JS.API.INFO at start.
GW_DEC_PROVISIONER_PUB=(
  '$JS.API.INFO'
  '$JS.API.STREAM.>'
)
GW_DEC_PROVISIONER_SUB=(
  "$GW_DEC_PROVISIONER_INBOX_PREFIX.>"
)
