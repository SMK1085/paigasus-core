{
  "title": "Paigasus IAM",
  "uid": "paigasus-iam",
  "tags": ["paigasus", "iam"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP request rate",
      "description": "iam_http_requests_total by status_class",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(iam_http_requests_total[$__rate_interval])) by (status_class)",
          "legendFormat": "{{status_class}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP p95 latency",
      "description": "iam_http_request_duration_seconds p95",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(iam_http_request_duration_seconds_bucket[$__rate_interval])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "gRPC request rate",
      "description": "iam_grpc_requests_total by service/method/grpc_status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(iam_grpc_requests_total[$__rate_interval])) by (service, method, grpc_status)",
          "legendFormat": "{{service}}/{{method}} {{grpc_status}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "gRPC non-OK ratio",
      "description": "share of iam_grpc_requests_total with grpc_status != ok",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(iam_grpc_requests_total{grpc_status!=\"ok\"}[$__rate_interval])) / sum(rate(iam_grpc_requests_total[$__rate_interval]))",
          "legendFormat": "non-ok ratio"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Authz decisions",
      "description": "iam_authz_decisions_total by decision",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(iam_authz_decisions_total[$__rate_interval])) by (decision)",
          "legendFormat": "{{decision}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Authz cache hit ratio",
      "description": "share of iam_authz_decisions_total with cache=hit",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(iam_authz_decisions_total{cache=\"hit\"}[$__rate_interval])) / sum(rate(iam_authz_decisions_total[$__rate_interval]))",
          "legendFormat": "cache hit ratio"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Audit write rate",
      "description": "iam_audit_records_total by outcome",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "wps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(iam_audit_records_total[$__rate_interval])) by (outcome)",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Denial-audit drops",
      "description": "iam_denial_audits_dropped_total (drain not keeping up)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(iam_denial_audits_dropped_total[$__rate_interval])",
          "legendFormat": "drops/sec"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Outbox drained rate",
      "description": "iam_outbox_relay_drained_total",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(iam_outbox_relay_drained_total[$__rate_interval])",
          "legendFormat": "drained/sec"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Outbox published rate",
      "description": "iam_outbox_relay_published_total",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(iam_outbox_relay_published_total[$__rate_interval])",
          "legendFormat": "published/sec"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Outbox publish-failure rate",
      "description": "iam_outbox_relay_publish_failures_total",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(iam_outbox_relay_publish_failures_total[$__rate_interval])",
          "legendFormat": "failures/sec"
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Outbox parked events (15m)",
      "description": "increase(iam_outbox_relay_parked_total[15m]) — poison events parked by the relay",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "increase(iam_outbox_relay_parked_total[15m])",
          "legendFormat": "parked"
        }
      ]
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Outbox oldest unpublished age",
      "description": "iam_outbox_oldest_unpublished_age_seconds gauge",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "iam_outbox_oldest_unpublished_age_seconds",
          "legendFormat": "age"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Outbox relay ticks rate",
      "description": "iam_outbox_relay_ticks_total by result",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(iam_outbox_relay_ticks_total[$__rate_interval])) by (result)",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 17,
      "type": "stat",
      "title": "Outbox dead-letter backlog",
      "description": "max by (job) (iam_outbox_parked_rows) — current parked-row backlog; NEVER sum across replicas, every replica reports the same global count (SMA-469)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 48 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (job) (iam_outbox_parked_rows)",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Outbox rows deleted",
      "description": "sum by (reason) (rate(iam_outbox_rows_deleted_total[5m])) — retention sweep deletes, by reason (SMA-469)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 48 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (reason) (rate(iam_outbox_rows_deleted_total[5m]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Policy snapshot reloads",
      "description": "iam_authz_policy_snapshot_reloads_total by outcome — 'installed' must stay non-zero (SMA-470)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 56 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(iam_authz_policy_snapshot_reloads_total[$__rate_interval])) by (outcome)",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Bootstrap-admin seed failures",
      "description": "iam_bootstrap_admin_seed_failures_total by stage — swallowed seed-attempt failures (SMA-468)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 64 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(iam_bootstrap_admin_seed_failures_total[$__rate_interval])) by (stage)",
          "legendFormat": "{{stage}}"
        }
      ]
    }
  ]
}
