# paigasus-iam config. Copy to iam.toml or supply via IAM_* env vars.
# Precedence: built-in defaults < iam.toml < IAM_* environment.

# http_addr = "0.0.0.0:8080"     # axum HTTP (health) — default shown
# grpc_addr = "0.0.0.0:9090"     # tonic gRPC (grpc.health.v1) — default shown
# log_level = "info"             # RUST_LOG-style filter — default shown

# REQUIRED — no default. Example:
# database_url = "postgres://postgres:postgres@127.0.0.1:5432/paigasus_iam"
#   or:  IAM_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/paigasus_iam

# --- Authentication: BYO-IdP OIDC (M2) ---

# [authn]
# leeway_secs = 60                    # exp/nbf clock-skew tolerance — default shown
# http_timeout_secs = 10              # discovery + JWKS fetch timeout — default shown
# jwks_ttl_secs = 3600                # JWKS cache TTL before refetch — default shown
# jwks_refresh_cooldown_secs = 30     # min gap between forced kid-miss refetches — default shown
# max_token_bytes = 16384             # reject larger bearer tokens before parsing — default shown

# [authn.jwks_cache]
# backend = "memory"                  # "memory" (default) | "redis"
# # redis_url = "redis://..."         # required iff backend = "redis"
#
# TRUST NOTE (D15): the JWKS cache holds the configured issuers' *public signing keys* —
# whoever can write to it can forge tokens. `backend = "redis"` therefore requires a
# dedicated instance, TLS + AUTH — a writable JWKS cache is an auth bypass. `memory`
# stays the default for exactly this reason.

# REQUIRED — no default. At least one issuer:
# [[authn.issuers]]
# issuer = "https://idp.example.com/realms/acme"
# audiences = ["paigasus"]
# jit_provisioning = true             # default shown
