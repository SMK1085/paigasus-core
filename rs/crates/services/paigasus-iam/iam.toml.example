# paigasus-iam config. Copy to iam.toml or supply via IAM_* env vars.
# Precedence: built-in defaults < iam.toml < IAM_* environment.

# http_addr = "0.0.0.0:8080"     # axum HTTP (health) — default shown
# grpc_addr = "0.0.0.0:9090"     # tonic gRPC (grpc.health.v1) — default shown
# log_level = "info"             # RUST_LOG-style filter — default shown

# REQUIRED — no default. Example:
# database_url = "postgres://postgres:postgres@127.0.0.1:5432/paigasus_iam"
#   or:  IAM_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/paigasus_iam

# --- Authentication: BYO-IdP OIDC (M2) ---

# [authn]
# leeway_secs = 60                    # exp/nbf clock-skew tolerance — default shown
# http_timeout_secs = 10              # discovery + JWKS fetch timeout — default shown
# jwks_ttl_secs = 3600                # JWKS cache TTL before refetch — default shown
# jwks_refresh_cooldown_secs = 30     # min gap between forced kid-miss refetches — default shown
# max_token_bytes = 16384             # reject larger bearer tokens before parsing — default shown
#
# TEST-ONLY — NEVER enable in production. `true` DISABLES TLS certificate verification
# for the discovery/JWKS fetches, letting any on-path attacker serve a forged JWKS
# (a full authentication bypass). Exists solely for integration tests against IdPs
# with self-signed dev certificates (mock IdP / Keycloak-in-Docker).
# accept_invalid_tls = false          # default shown

# [authn.jwks_cache]
# backend = "memory"                  # "memory" (default) | "redis"
# # redis_url = "rediss://..."        # required iff backend = "redis"; use the TLS
# #                                   # scheme (rediss://) + AUTH credentials in the URL
#
# TRUST NOTE (D15): the JWKS cache holds the configured issuers' *public signing keys* —
# whoever can write to it can forge tokens. `backend = "redis"` therefore requires a
# dedicated instance, TLS (`rediss://`, supported via rustls) + AUTH — a writable JWKS
# cache is an auth bypass. `memory` stays the default for exactly this reason.

# REQUIRED — no default. At least one issuer:
# [[authn.issuers]]
# issuer = "https://idp.example.com/realms/acme"
# audiences = ["paigasus"]
# jit_provisioning = true             # default shown

# --- API keys & service accounts (M4) ---

# [api_keys]
#
# REQUIRED — no valid default (the empty-string default fails `IamConfig::validate`, not
# figment extraction — an unset pepper loads fine but boots refuse to start). >=32 decoded
# bytes, standard (padded) base64. NEVER logged/dumped: a redacting newtype, skipped from
# IamConfig's Serialize and redacted in its Debug (SMA-445 D12).
# pepper = "<>=32 raw bytes, base64-encoded>"    # or IAM_API_KEYS__PEPPER
#
# key_prefix              = "pgs_sk_" # must be non-empty & not collide (case-insensitively)
#                                      # with "Bearer" — default shown
# max_token_bytes         = 512       # reject larger bearer tokens before parsing — default shown
# # default_expiry_days   = 365       # unset by default — non-expiring until revoked
# last_used_throttle_secs = 60        # min gap between last_used_at writes — default shown
#
# [api_keys.introspect_cache]
# backend  = "memory"                 # "memory" (default, single-replica/dev) | "redis" (HA)
# # redis_url = "redis://..."         # required iff backend = "redis"
# ttl_secs = 30                       # default shown — bounds cross-replica/put-after-evict
#                                      # revocation staleness (spec D5)

# --- Persistent denial audit (M5, SMA-446) ---

# [audit]
# denial_buffer_capacity = 4096       # bounded, non-blocking ring buffer for authz-denial
#                                      # audit entries awaiting out-of-band persistence to
#                                      # Postgres — default shown; must be >= 1. Denial auditing
#                                      # is best-effort: when full, the OLDEST queued entry is
#                                      # dropped (favoring recent denials) and a monotonic
#                                      # `dropped_denial_audits` gauge is emitted. A sustained
#                                      # increase means the drain isn't keeping up — raise this
#                                      # capacity or investigate the audit DB. This is a
#                                      # deliberate tradeoff: no durable spooling.
#
# --- Audit-log query window (SMA-467) ---
# query_default_window_days = 90      # lookback applied when an audit `query` supplies neither
#                                      # `from` nor `to`, so the read prunes to recent partitions
#                                      # instead of scanning every leaf — default shown; must be >= 1
# query_max_window_days     = 366     # hard cap on any `from`/`to` span; an over-wide range is
#                                      # clamped to this — default shown; must be >= 1

# --- Audit-log partition maintenance + outcome-aware retention (SMA-467) ---

# [audit.retention]
# enabled            = true    # default shown. false = don't run the maintenance task at all
#                                # (no create-ahead, no pruning). To pause only DELETIONS while
#                                # keeping create-ahead healthy, leave this true and set the two
#                                # *_months below to 0 instead.
# interval_secs       = 86400   # seconds between maintenance ticks (create-ahead + prune) —
#                                # default shown (daily); must be >= 1
# ahead_months        = 1       # months of leaf partitions to pre-create ahead of time —
#                                # default shown; must be within 1..=24
# denied_months       = 3       # drop denied monthly partitions older than this — default
#                                # shown; 0 = never drop denied
# committed_months    = 0       # drop committed monthly partitions older than this — default
#                                # shown (never); a non-zero value auto-deletes compliance rows,
#                                # opt-in only

# --- Transactional outbox relay (M5, SMA-446) ---

# [outbox]
# relay_enabled       = true          # default shown. `false` boots without spawning the
#                                      # relay — `event_outbox` rows still accrue (written
#                                      # inside each triggering mutation's own transaction
#                                      # unconditionally), they just go undrained until an
#                                      # operator re-enables this and restarts.
# poll_interval_secs  = 5             # sleep between drain ticks — default shown; must be >= 1
# batch_size          = 100           # rows locked (`FOR UPDATE SKIP LOCKED`) + processed per
#                                      # tick — default shown; must be >= 1
# max_attempts        = 5             # publish failures before a row is parked (excluded from
#                                      # future ticks) — default shown; must be >= 1

# --- Metrics (SMA-446 Unit 3: Prometheus `GET /metrics`) ---

# [metrics]
# enabled = true                # default shown; false skips installing the recorder entirely —
#                                # no /metrics route, no metrics-facade recorder in this process
# addr = "127.0.0.1:9091"       # optional separate internal listener, so /metrics never shares
#                                # a port with the tenancy/authn/authz HTTP API. unset (default)
#                                # merges /metrics onto http_addr instead. MUST differ from
#                                # http_addr (rejected by IamConfig::validate).
