{
  "model": "claude-sonnet-5-5",
  "tools": [
    {
      "name": "get_weather",
      "description": "Get the weather for a city.",
      "input_schema": {
        "type": "object",
        "properties": {
          "city": {
            "type": "string"
          },
          "unit": {
            "type": "string",
            "enum": [
              "c",
              "f"
            ]
          }
        },
        "required": [
          "city",
          "unit"
        ]
      }
    },
    {
      "name": "read_file",
      "description": "Read a file from the workspace.",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ]
      }
    }
  ],
  "messages": [
    {
      "role": "user",
      "content": "What is the weather in Paris, in celsius?"
    }
  ]
}
