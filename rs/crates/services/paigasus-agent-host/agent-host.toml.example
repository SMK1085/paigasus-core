# The agent host needs its own database. A separate schema in a shared database is not supported.

# http_addr = "0.0.0.0:8086"
# database_url = "postgres://user:password@localhost/agent_host"   # required
# log_level = "info"

# [metrics]
# enabled = true
# addr = "127.0.0.1:9100"   # optional; the port must differ from the port of http_addr

# [migration]
# lock_wait_secs = 120      # 1 to 3600

# [worker]
# enabled = true
# concurrency = 4           # runs at the same time. Range 1 to 64
#                           # One replica opens 2 x concurrency + 8 main connections and
#                           # concurrency + 1 lease connections (201 at the maximum of 64).
#                           # The sum over all replicas must stay below the Postgres
#                           # max_connections (default 100).
# poll_interval_ms = 1000   # the time between two claim polls. Range 100 to 60000
# max_runs_per_lease = 8    # the most runs that one lease serves. Range 1 to 1000
# host_fault_pause_after = 3   # host faults in a row before the pool pauses its claims. Range 1 to 100
# host_fault_pause_secs = 30   # the first pause. Each next pause is double, up to 600. Range 1 to 600

# [run]
# max_turns = 16            # the most model turns of one run. Range 1 to 256
# timeout_secs = 300        # the time limit of one run. Range 1 to 3600

# [retry]
# base_delay_secs = 30      # the delay before the first retry. Range 1 to 3600
# max_delay_secs = 1800     # the cap of the delay. Range 1 to 86400, and at least base_delay_secs

# One table per agent. The id is an agent PRN: prn:pgs:agents::<org-uuid>:agent/<agent-uuid>.
# The ids must be unique. The only known tool is "memory".
# [[agents]]
# id = "prn:pgs:agents::00000000-0000-0000-0000-000000000001:agent/00000000-0000-0000-0000-000000000002"
# name = "triage"
# model = "claude"          # a model name: "scripted" or a [[models]] name. Boot checks it against the model registry
# instructions = "Sort the request and answer it."
# tools = ["memory"]        # optional

# The gateway and the models are optional. Use both sections or neither.
# The agent host calls Claude only through the gateway route POST /v1/messages.
# The gateway needs [messages] enabled = true, an [upstream.anthropic] section and streaming on.
# The key needs the gateway_user role. Every agent on a gateway model has the same organization.
# [gateway]
# base_url = "https://gateway.internal.example.com"   # https, or http for a loopback host. No user name, query or fragment
# api_key_file = "/etc/agent-host/gateway.key"        # one line, read once at boot. No config key holds the key
# ca_file = "/etc/agent-host/gateway-ca.pem"          # optional; REPLACES the platform roots, so it must hold every root the gateway chain needs
# connect_timeout_ms = 5000     # 100 to 60000
# read_timeout_ms = 60000       # 1000 to 600000. 3 x this value must be less than run.timeout_secs in milliseconds
#
# One table per model. The provider "anthropic" is the only value. The name "scripted" is reserved.
# [[models]]
# name = "claude"
# provider = "anthropic"
# model = "claude-sonnet-4-5"   # the model id that the gateway gets
# max_output_tokens = 4096      # required. Range 1 to 128000

# [lease]
# ttl_secs = 30             # 3 to 600, and at least 3 x heartbeat_interval_secs
# heartbeat_interval_secs = 10   # 1 to 200

# [claim]
# batch_limit = 20          # 1 to 500
# max_attempts = 5          # 1 to 100
# thread_ttl_secs = 86400   # 60 to 31536000

# [ingress]
# max_body_bytes = 262144   # 1024 to 4194304

# The HTTP event ingress is on only when this section is set.
# The routes POST /v1/inboxes/{inbox}/events and GET /v1/service-info need it.
# [iam]
# grpc_addr = "https://iam.internal.example.com:9090"
# tls = { mode = "tls" }    # optional: ca_cert_path (REPLACES the trust store), and
#                           # client_cert_path with client_key_path (mTLS: both or neither)
# call_timeout_ms = 2000    # 100 to 30000
# For a loopback grpc_addr only: tls = { mode = "loopback_insecure" }

# [mid_run]
# policy = "queue"          # only "queue"; "fold" and "interrupt" are refused at boot

# The NATS source is optional. Without this section, no NATS task starts.
# First deployment: boot without this section, create the inbox, add the section, restart.
# [nats]
# url = "nats://nats.internal.example.com:4222"
# creds_file = "/etc/agent-host/agent-host-consumer.creds"   # optional
# ca_file = "/etc/agent-host/nats-ca.pem"                    # optional; replaces the system roots, so it must hold every root the server chain needs
# stream = "IAM_EVENTS"            # must be "IAM_EVENTS"
# durable = "agent-host-inbox"     # must be "agent-host-inbox"
#
# One table per channel; at least one is required. A channel maps one subject filter to one inbox.
# The filters of two channels must not match the same subject.
# The source must start with "urn:paigasus:agents:nats:" and must be unique.
# The filters of the durable must equal the channel subjects, or boot stops.
# [[nats.channels]]
# subject = "iam.organization.>"
# inbox = "00000000-0000-0000-0000-000000000000"   # the inbox UUID
# source = "urn:paigasus:agents:nats:iam-org"

# [memory]
# backend = "postgres"      # "postgres" or "s3". A backend switch does not move data. "s3" needs [memory.s3]
#                           # "s3" with worker.enabled = true and an [[agents]] entry stops the boot: the worker supports only "postgres" for now
# [memory.caps]
# max_file_bytes = 65536          # greater than 0
# max_store_bytes = 1048576       # greater than 0
# max_store_files = 512           # greater than 0
# max_loaded_file_bytes = 8192    # the cut of a file loaded at run start (not view). Greater than 0, at most max_file_bytes

# [memory.s3]                                   # only with backend = "s3". No credential key exists: see the README
# bucket = "paigasus-mem"                       # required. 3 to 63 characters of a-z, 0-9, "." and "-"
# prefix = "mem"                                # required. The key prefix. The prefixes of two deployments must not nest
# region = "us-east-1"
# endpoint = "http://127.0.0.1:9000"            # not set means AWS. No user name, query or fragment
# path_style = true                             # default: true with an endpoint or a dotted bucket, else false
# allow_http = false                            # an http endpoint needs true. For local tests and development only
# extra_ca_bundle_path = "/etc/ssl/extra.pem"   # ADDs to the platform roots. Roots only. Read once at boot
# apply_deadline_secs = 10                      # at least 1, less than lease.ttl_secs

# [timers]
# enabled = true                          # run the scheduler loop. false stops only the loop. The tools still work
# poll_interval_secs = 5                  # the time between two passes. Range 1 to 300
# pass_limit = 100                        # the most rows that one pass processes. Range 1 to 1000
# statement_timeout_ms = 5000             # SET LOCAL statement_timeout of each fire transaction. Range 100 to 60000
# min_schedule_interval_secs = 900        # the smallest civil gap between two slots of a schedule. Range 60 to 86400
# max_active_per_inbox = 50               # the most active agent timers of one inbox. Range 1 to 1000
# max_horizon_days = 366                  # the latest follow-up, and the window for the first slot. Range 1 to 366
# max_fire_attempts = 10                  # failed fire attempts before a timer goes to failed. Range 1 to 1000
# min_follow_up_delay_secs = 60           # the shortest follow-up, from the time of the tool call. Range 1 to 86400
# max_agent_timers_created_per_day = 100  # the most agent timers one inbox makes in a rolling 24 hours. Range 1 to 10000
