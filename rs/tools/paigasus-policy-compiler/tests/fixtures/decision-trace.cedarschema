// SPDX-License-Identifier: Apache-2.0
// SMA-755: the action schema for the decision-trace replay (tests/decision_trace.rs). Test-only.
// The gateway encoder logs `input: {}` for every request event, so no `input` field is required.
// Dogwood 1.2.0 checks a replayed event against the signature of its action.
// This is exactly the relaxed-schema workaround (SMA-815). A schema with required input fields denies every call.

namespace Pgs::Iam {
  entity Principal;
  entity Organization;
}

namespace Pgs::Gateway {
  type CallInfo = { declared: String };
  type RequestInfo = { ingress: String, model: String, scope: String };
  type SessionInfo = { id: String, turn: Long };

  action "InvokeTool";

  action "search" in ["InvokeTool"] appliesTo {
    principal: [Pgs::Iam::Principal],
    resource: [Pgs::Iam::Organization],
    context: {
      input: { q?: String, n?: Long },
      findings: Set<String>,
      call: CallInfo,
      request: RequestInfo,
      session: SessionInfo
    }
  };

  action "read_file" in ["InvokeTool"] appliesTo {
    principal: [Pgs::Iam::Principal],
    resource: [Pgs::Iam::Organization],
    context: {
      input: { path?: String },
      findings: Set<String>,
      call: CallInfo,
      request: RequestInfo,
      session: SessionInfo
    }
  };
}
