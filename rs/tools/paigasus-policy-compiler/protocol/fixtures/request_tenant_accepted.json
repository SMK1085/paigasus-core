  "source": "@id(\"allow-tools\")\npermit (principal, action in Pgs::Gateway::Action::\"InvokeTool\", resource);\n@id(\"no-send-after-search\")\nforbid (principal, action == Pgs::Gateway::Action::\"send\", resource)\nwhen temporal { formerly within 10m Pgs::Gateway::Action::\"search\"::response{ input.q: \"secret\" } };\n@id(\"search-rate\")\n@scope(\"principal\")\nforbid (principal, action == Pgs::Gateway::Action::\"search\", resource)\nwhen temporal { count_within(1h, Pgs::Gateway::Action::\"search\"::request{}) > 50 };\n"
