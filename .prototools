# proto itself, pinned to the first release whose bundled schema engine (schema_tool
# 0.18.0, moonrepo/plugins#151) supports [platform.*.arch] overrides — without this floor
# the Linux-aarch64 fix in .proto/plugins/{buf,lefthook}.toml is silently inert. (SMA-411)
proto = "0.58.1"
actionlint = "1.7.12"
buf = "1.70.0"
cargo-deny = "0.19.8"
cargo-machete = "0.9.2"
cargo-nextest = "0.9.136"
lefthook = "2.1.8"
maturin = "1.9.6"
moon = "2.3.2"
osv-scanner = "2.5.0"
promtool = "3.13.1"
release-plz = "0.3.158"
wasm-pack = "0.15.0"

# Moon-managed runtime toolchains, also pinned here so the proto SHIMS resolve a version in a
# fresh CI env (cache:false → clean ~/.proto). Under moon 2.3.2 a bare `pnpm`/`uv`/`node` call in
# a CI `run:` step (e.g. `pnpm store path`, `uv cache dir`, `pnpm --dir ts install`) reads the
# version from .prototools, NOT from .moon/toolchains.yml — without these it fails with
# `proto::detect::failed`. moon keeps in sync via versionFromPrototools (default true); values
# mirror .moon/toolchains.yml.
node = "24.16.0"
pnpm = "11.3.0"
uv = "0.11.16"

[plugins]
actionlint = "file://./.proto/plugins/actionlint.toml"
buf = "file://./.proto/plugins/buf.toml"
cargo-deny = "file://./.proto/plugins/cargo-deny.toml"
cargo-machete = "file://./.proto/plugins/cargo-machete.toml"
cargo-nextest = "file://./.proto/plugins/cargo-nextest.toml"
lefthook = "file://./.proto/plugins/lefthook.toml"
maturin = "file://./.proto/plugins/maturin.toml"
osv-scanner = "file://./.proto/plugins/osv-scanner.toml"
promtool = "file://./.proto/plugins/promtool.toml"
release-plz = "file://./.proto/plugins/release-plz.toml"
wasm-pack = "file://./.proto/plugins/wasm-pack.toml"
