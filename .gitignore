# ─── Secrets / environment ───────────────────────────────────────────────
.env
.env.*
!.env*.example
*.pem
*.key
*.p12

# ─── Rust ────────────────────────────────────────────────────────────────
target/
**/*.rs.bk
*.pdb

# ─── Node / TypeScript ───────────────────────────────────────────────────
node_modules/
.next/
out/
.pnpm-store/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/

# ─── Build output (shared) ───────────────────────────────────────────────
dist/
build/

# ─── Moon ────────────────────────────────────────────────────────────────
.moon/cache/
.moon/docker/

# ─── release-plz ─────────────────────────────────────────────────────────
# `release-plz generate-schema` output; nothing in-repo consumes it.
.schema/

# ─── Editors / IDE ───────────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
.history/

# ─── OS noise ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.directory

# ─── Agent scratch state ─────────────────────────────────────────────────
# Per-machine runtime state, never publishable: `.claude/worktrees/` holds entire
# repository checkouts and `scheduled_tasks.lock` is session state (it was tracked by
# accident until SMA-520 and is untracked in that same commit). Without this, a stray
# `git add -A` before the SMA-520 visibility flip publishes it all to a public repo.
#
# `.claude/*` rather than `.claude/` on purpose: excluding the DIRECTORY stops git
# descending into it, which would make the negation below inert. Shared project config
# stays deliberately committable.
.claude/*
!.claude/settings.json
.entire/

# SMA-500: chisel package manifests are CI artifacts, not tracked files.
chisel-manifest-*.txt
