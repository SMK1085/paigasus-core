# Pin the public npm registry explicitly. This is a public, Apache-2.0 repo: its
# dependencies come from npmjs.org, NOT from any private mirror (e.g. an internal AWS
# CodeArtifact proxy that a developer's global ~/.npmrc might redirect to). Without this
# line, resolution silently follows whatever registry the ambient config points at, which
# differs between CI (npm) and a developer machine — making installs non-reproducible.
registry=https://registry.npmjs.org/
